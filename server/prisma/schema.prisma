// Prisma schema for Village1 — MySQL (Production Target)
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  SHOPKEEPER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ShopMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY_FOR_PICKUP
  COLLECTED
  COMPLETED
  CANCELLATION_REQUESTED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_PICKUP
  UPI_QR
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  SKIPPED
  CANCELLED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

model User {
  id               String            @id @default(uuid())
  phone            String?           @unique
  email            String?           @unique
  passwordHash     String
  role             UserRole          @default(CUSTOMER)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  customerProfile  CustomerProfile?
  addresses        UserAddress[]
  refreshTokens    RefreshToken[]
  shopMemberships  ShopMember[]
  orders           Order[]
  appointments     Appointment[]
  queueTokens      QueueToken[]
  reviews          Review[]
  complaints       Complaint[]
  auditLogs        AuditLog[]

  cancellationRequestsSubmitted CancellationRequest[] @relation("RequestingUser")
  cancellationRequestsDecided   CancellationRequest[] @relation("DecidingUser")
  orderEvents                   OrderEvent[]

  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  fullName          String
  village           String
  district          String
  state             String    @default("Tamil Nadu")
  pinCode           String
  preferredLanguage String    @default("en")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([village])
}

model UserAddress {
  id           String    @id @default(uuid())
  userId       String
  addressLine  String
  village      String
  district     String
  state        String    @default("Tamil Nadu")
  pinCode      String
  landmark     String?
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShopCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  shops       Shop[]
}

model Shop {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  categoryId         String
  description        String?            @db.Text
  address            String
  village            String
  district           String
  state              String             @default("Tamil Nadu")
  pinCode            String
  latitude           Float?
  longitude          Float?
  phone              String
  email              String?
  openingHours       String             @default("08:00")
  closingHours       String             @default("21:00")
  weeklyHoliday      String?            @default("None")
  logoUrl            String?
  coverImageUrl      String?
  verificationStatus VerificationStatus @default(PENDING)
  approvalReason     String?
  approvedAt         DateTime?
  isActive           Boolean            @default(false)
  pickupInstructions String?            @db.Text
  policies           String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  category           ShopCategory       @relation(fields: [categoryId], references: [id])
  members            ShopMember[]
  products           Product[]
  orders             Order[]
  services           ShopService[]
  appointments       Appointment[]
  queueTokens        QueueToken[]
  reviews            Review[]
  complaints         Complaint[]
  inventoryLogs      InventoryLog[]
  bills              Bill[]

  @@index([categoryId])
  @@index([village])
  @@index([verificationStatus])
  @@index([isActive])
}

model ShopMember {
  id          String         @id @default(uuid())
  shopId      String
  userId      String
  role        ShopMemberRole @default(STAFF)
  permissions String         @default("orders,inventory")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId])
  @@index([shopId])
}

model Product {
  id                 String         @id @default(uuid())
  shopId             String
  name               String
  category           String?
  description        String?        @db.Text
  sku                String?
  price              Float
  mrp                Float?
  stock              Int            @default(0)
  unit               String         @default("piece")
  imageUrl           String?
  isAvailable        Boolean        @default(true)
  isArchived         Boolean        @default(false)
  lowStockThreshold  Int            @default(5)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  shop               Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  inventoryLogs      InventoryLog[]
  billItems          BillItem[]

  @@index([shopId])
  @@index([isAvailable])
  @@index([isArchived])
}

model InventoryLog {
  id            String    @id @default(uuid())
  productId     String
  shopId        String
  type          String    // RESTOCK, SALE_POS, SALE_ONLINE, ADJUSTMENT, RETURN, DAMAGE, REVERSAL
  quantityDelta Int
  previousStock Int
  newStock      Int
  reason        String?
  actorId       String?
  referenceId   String?
  createdAt     DateTime  @default(now())

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([productId])
  @@index([createdAt])
}

model Bill {
  id             String     @id @default(uuid())
  invoiceNumber  String     @unique
  shopId         String
  operatorId     String?
  customerName   String?
  customerPhone  String?
  customerAddress String?
  status         String     @default("FINALIZED") // DRAFT, FINALIZED, VOIDED
  subtotal       Float
  discount       Float      @default(0)
  totalAmount    Float
  paymentMethod  String     @default("CASH") // CASH, UPI
  paymentStatus  String     @default("PAID_CASH") // PAID_CASH, PENDING_VERIFICATION, VERIFIED_UPI
  paymentReference String?
  cashReceived   Float?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  shop           Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items          BillItem[]

  @@index([shopId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([createdAt])
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  productId   String?
  productName String
  sku         String?
  unitPrice   Float
  quantity    Int
  totalPrice  Float
  createdAt   DateTime @default(now())

  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([productId])
}

model Order {
  id                   String                @id @default(uuid())
  orderNumber          String                @unique
  shopId               String
  customerId           String
  status               OrderStatus           @default(PENDING)
  rejectionReason      String?
  pickupCode           String?
  totalAmount          Float
  subtotalAmount       Float
  taxAmount            Float                 @default(0)
  paymentMethod        PaymentMethod         @default(CASH_ON_PICKUP)
  paymentStatus        PaymentStatus         @default(PENDING)
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  shop                 Shop                  @relation(fields: [shopId], references: [id])
  customer             User                  @relation(fields: [customerId], references: [id])
  items                OrderItem[]
  events               OrderEvent[]
  cancellationRequest  CancellationRequest?
  replacementRequests  ReplacementRequest[]
  payments             Payment[]
  complaints           Complaint[]

  @@index([shopId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String    @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Float
  quantity    Int
  totalPrice  Float
  isPacked    Boolean   @default(false)
  packedAt    DateTime?
  createdAt   DateTime  @default(now())

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id         String    @id @default(uuid())
  orderId    String
  fromStatus String?
  toStatus   String
  actorId    String?
  notes      String?
  createdAt  DateTime  @default(now())

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model CancellationRequest {
  id               String        @id @default(uuid())
  orderId          String        @unique
  requestingUserId String
  reason           String
  status           RequestStatus @default(PENDING)
  decisionNotes    String?
  decidedByUserId  String?
  decidedAt        DateTime?
  createdAt        DateTime      @default(now())

  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestingUser   User          @relation("RequestingUser", fields: [requestingUserId], references: [id])
  decidedByUser    User?         @relation("DecidingUser", fields: [decidedByUserId], references: [id])

  @@index([orderId])
}

model ReplacementRequest {
  id                  String        @id @default(uuid())
  orderId             String
  originalProductId   String
  originalProductName String
  replacementProductId String
  replacementProductName String
  originalPrice       Float
  replacementPrice    Float
  originalQuantity    Int
  replacementQuantity Int
  priceDifference     Float
  status              RequestStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ShopService {
  id              String        @id @default(uuid())
  shopId          String
  name            String
  description     String?
  price           Float
  durationMinutes Int           @default(30)
  isAvailable     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([shopId])
}

model Appointment {
  id              String            @id @default(uuid())
  bookingNumber   String            @unique
  shopId          String
  customerId      String
  serviceId       String
  appointmentDate DateTime
  startTime       String
  endTime         String
  status          AppointmentStatus @default(PENDING)
  queueToken      String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  shop            Shop              @relation(fields: [shopId], references: [id])
  customer        User              @relation(fields: [customerId], references: [id])
  service         ShopService       @relation(fields: [serviceId], references: [id])
  payments        Payment[]
  queueRecord     QueueToken?

  @@index([shopId])
  @@index([customerId])
  @@index([appointmentDate])
  @@index([status])
}

model QueueToken {
  id            String      @id @default(uuid())
  shopId        String
  customerId    String
  appointmentId String?     @unique
  tokenNumber   Int
  date          DateTime    @default(now())
  status        QueueStatus @default(WAITING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  shop          Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer      User        @relation(fields: [customerId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([shopId, date])
}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String?
  appointmentId        String?
  amount               Float
  method               PaymentMethod @default(CASH_ON_PICKUP)
  status               PaymentStatus @default(PENDING)
  transactionReference String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order                Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  appointment          Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([appointmentId])
}

model Review {
  id         String   @id @default(uuid())
  shopId     String
  customerId String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer   User     @relation(fields: [customerId], references: [id])

  @@index([shopId])
  @@index([customerId])
}

model Complaint {
  id          String          @id @default(uuid())
  customerId  String
  shopId      String?
  orderId     String?
  subject     String
  description String          @db.Text
  status      ComplaintStatus @default(OPEN)
  resolution  String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  customer    User            @relation(fields: [customerId], references: [id])
  shop        Shop?           @relation(fields: [shopId], references: [id], onDelete: SetNull)
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([shopId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
