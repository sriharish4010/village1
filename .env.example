# ==========================================================
# Village1 Platform — Environment Configuration Template
# Copy this file to .env or server/.env before starting
# ==========================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (Prisma)
# Production MySQL URL format:
DATABASE_URL="mysql://root:password@localhost:3306/village1_db"
# Or SQLite URL for instant testing without MySQL installed:
# DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets (Generate strong random strings in production!)
JWT_ACCESS_SECRET="village1_access_secret_super_secure_key_2026_dev_only"
JWT_REFRESH_SECRET="village1_refresh_secret_super_secure_key_2026_dev_only"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY_DAYS="7"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

# Platform Admin Initial Seed (Dev Only)
SEED_ADMIN_EMAIL=admin@village1.in
SEED_ADMIN_PHONE=9999900001
SEED_ADMIN_PASSWORD=AdminSecure@123

# Shopkeeper Initial Seed (Dev Only)
SEED_SHOPKEEPER_EMAIL=shopkeeper@village1.in
SEED_SHOPKEEPER_PHONE=9876543210
SEED_SHOPKEEPER_PASSWORD=Shopkeeper@123

# Customer Initial Seed (Dev Only)
SEED_CUSTOMER_EMAIL=customer@village1.in
SEED_CUSTOMER_PHONE=9123456780
SEED_CUSTOMER_PASSWORD=Customer@123
